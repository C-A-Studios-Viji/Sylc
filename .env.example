# Browser-safe values only. Never put provider keys or server encryption secrets in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Edge Function secrets (set with `supabase secrets set`, never expose to the browser)
# Generate 32 random bytes and base64 encode them for VAULT_ENCRYPTION_KEY.
VAULT_ENCRYPTION_KEY=BASE64_32_BYTE_KEY
ACCESS_CODE_PEPPER=LONG_RANDOM_SECRET
RATE_LIMIT_PEPPER=ANOTHER_LONG_RANDOM_SECRET
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
